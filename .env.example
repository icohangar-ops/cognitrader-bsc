# ─── BSC Configuration ───────────────────────────────────────
# Get an RPC URL from https://bsc-dataseed.binance.org or a provider like Alchemy/Infura
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Optional comma-separated backup RPC endpoints. On a failed call the agent
# retries (3 attempts, 1s/2s/4s backoff) and rotates to the next node.
BSC_RPC_FALLBACK_URLS=https://bsc-dataseed1.defibit.io,https://bsc-dataseed1.ninicoin.io
BSC_CHAIN_ID=56
# Your BNB Chain wallet address (must hold BNB for gas + trading)
BSC_WALLET_ADDRESS=0x_YOUR_WALLET_ADDRESS
# Private key (NEVER share or commit this)
BSC_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY

# ─── PancakeSwap (BSC Mainnet Defaults) ──────────────────────
PANCAKESWAP_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
PANCAKESWAP_FACTORY=0xcA143Ce32Fe78f1f7019d72855a1425CE3c76cC1
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# ─── CoinMarketCap API ──────────────────────────────────────
# Get your API key from https://pro.coinmarketcap.com/
CMC_API_KEY=your_cmc_api_key_here
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_RATE_LIMIT_MS=5000

# ─── Trust Wallet Agent Kit (TWAK) ─────────────────────────
TWAK_WALLET_PATH=./wallet.json
TWAK_POLICY_ENGINE=true
TWAK_MAX_TX_BNB=5
TWAK_ALLOWED_TOKENS=CAKE,BNB,BUSD,USDT,ETH,ADA,SOL,AVAX
TWAK_REQUIRE_CONFIRMATION=false
TWAK_AUTONOMOUS_MODE=true

# ─── Agent Configuration ───────────────────────────────────
# Polling interval in milliseconds (30s default)
AGENT_POLLING_INTERVAL=30000
# Maximum concurrent open positions
AGENT_MAX_POSITIONS=3
# Max position size as fraction of portfolio (10%)
AGENT_MAX_POSITION_PCT=0.10
# Stop-loss threshold (5%)
AGENT_STOP_LOSS_PCT=0.05
# Take-profit threshold (15%)
AGENT_TAKE_PROFIT_PCT=0.15
# Daily drawdown limit before halting (10%)
AGENT_DAILY_DRAWDOWN_PCT=0.10
# Minimum composite signal score to act (0-100)
AGENT_MIN_SIGNAL_SCORE=65
# Minimum signal confidence (0-1)
AGENT_MIN_CONFIDENCE=0.6
# Slippage tolerance in basis points (50 = 0.5%)
AGENT_SLIPPAGE_BPS=50

# ─── Safety: Set to "true" for dry-run (no real trades) ───
AGENT_DRY_RUN=true

# ─── Active strategies (comma separated) ───────────────────
AGENT_STRATEGIES=MOMENTUM,SENTIMENT,MEAN_REVERSION

# ─── Tokens to monitor (comma separated) ───────────────────
AGENT_TOKENS=CAKE,ETH,ADA,SOL,AVAX

# ─── Logging ───────────────────────────────────────────────
AGENT_LOG_LEVEL=info

# ─── PRISMtrace (optional) ─────────────────────────────────
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=

# ─── CHP — Consensus Hardening Protocol (decision gate) ─────
# Every trade decision passes the R0 solvability gate, a deterministic
# adversary foundation pass (defi domain, floor 85), and a human lock
# before execution. See README.md "Consensus Hardening Protocol".
# Require a named human confirmer before any trade executes (default on).
CHP_REQUIRE_HUMAN_LOCK=true
# Append-only decision ledger (JSONL, tamper-evident via SHA-256).
CHP_LEDGER_PATH=./state/chp-decisions.jsonl

# HMAC key for trade-execution receipts (src/chp/receipt.ts). REQUIRED —
# there is no default: the agent refuses to start without it, because a
# committed fallback key would make receipt forgery trivial. Every
# capital-moving trade needs a signed, single-use receipt.
CHP_RECEIPT_KEY=
# Replay log for consumed receipt nonces (src/chp/replay.ts). Optional
# override of the default ./state/replay-nonces.jsonl; persists single-use
# nonces across restarts so a pre-restart receipt cannot be replayed.
CHP_REPLAY_LOG=
